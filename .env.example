# Server and Runtime Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Neon Serverless PostgreSQL)
# Example: postgres://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If left empty, the application seamlessly falls back to the in-memory persistence layer.
DATABASE_URL=

# Authentication & Session Secret
SESSION_SECRET=mahima-batparss-2026-secret-session-key

# Initial Default Administrator Credentials (bootstrapped on initial database migration)
ADMIN_EMAIL=admin@batparss.com
ADMIN_PASSWORD=batparss2026
